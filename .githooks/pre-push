#!/bin/sh
set -eu

root=$(git rev-parse --show-toplevel)
scanner="$root/.local/gitleaks/gitleaks"
if [ -f "$scanner.exe" ]; then
    scanner="$scanner.exe"
fi
if [ ! -f "$scanner" ]; then
    echo "Push bloqueado: prepare o Gitleaks 8.30.1 conforme spec.md, secao 16.1." >&2
    exit 1
fi
if [ "$("$scanner" version)" != "8.30.1" ]; then
    echo "Push bloqueado: versao do Gitleaks diferente da baseline." >&2
    exit 1
fi
if ! "$scanner" git --redact=100 --no-banner --log-level error \
        --ignore-gitleaks-allow --log-opts="--all" "$root"; then
    echo "Push bloqueado: scanner encontrou um achado ou nao concluiu. Investigue sem publicar valores." >&2
    exit 1
fi

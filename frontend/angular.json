{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false
  },
  "projects": {
    "console": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "styles": [
              "src/styles.css"
            ],
            "outputPath": "dist/console"
          },
          "configurations": {
            "contas": {
              "fileReplacements": [
                {"replace": "src/console-profile.ts", "with": "src/console-profile.contas.ts"}
              ]
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            },
            "production": {
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "600kB",
                  "maximumError": "800kB"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "console:build:development",
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "contas": {"buildTarget": "console:build:development,contas"}
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "runner": "vitest",
            "coverageReporters": ["text-summary", "lcovonly"]
          }
        }
      }
    }
  }
}

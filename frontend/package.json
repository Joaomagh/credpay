{
  "name": "credpay-console",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "vite": "8.3.5"
  },
  "engines": {
    "node": "^24.22.1",
    "npm": ">=10.9.2"
  },
  "scripts": {
    "start": "ng serve --host 127.0.0.1",
    "build": "ng build",
    "test": "ng test --watch=false",
